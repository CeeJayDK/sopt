diff --git a/source/opengl/opengl_impl_device.cpp b/source/opengl/opengl_impl_device.cpp
index e659863..9bd00cd 100644
--- a/source/opengl/opengl_impl_device.cpp
+++ b/source/opengl/opengl_impl_device.cpp
@@ -259,13 +259,51 @@ reshade::opengl::device_impl::device_impl(HDC initial_hdc, HGLRC shared_hglrc, c
 		gl.LinkProgram(_mipmap_program);
 		gl.DeleteShader(mipmap_cs);
 	}
+	// Variant for filterable formats, which averages each 2x2 block with a single bilinear fetch
+	{
+		const resources::data_resource cs = resources::load_data_resource(IDR_MIPMAP_LINEAR_CS_GLSL);
+
+		const int shader_source_length[] = { static_cast<int>(cs.data_size) };
+		const char *const shader_source[] = { static_cast<const char *>(cs.data) };
+
+		const GLuint mipmap_cs = gl.CreateShader(GL_COMPUTE_SHADER);
+		gl.ShaderSource(mipmap_cs, static_cast<GLsizei>(std::size(shader_source)), shader_source, shader_source_length);
+		gl.CompileShader(mipmap_cs);
+
+		_mipmap_linear_program = gl.CreateProgram();
+		gl.AttachShader(_mipmap_linear_program, mipmap_cs);
+		gl.LinkProgram(_mipmap_linear_program);
+		gl.DeleteShader(mipmap_cs);
+
+		GLint link_status = GL_FALSE;
+		gl.GetProgramiv(_mipmap_linear_program, GL_LINK_STATUS, &link_status);
+		if (link_status != GL_TRUE)
+		{
+			reshade::log::message(reshade::log::level::warning, "Failed to compile bilinear mipmap generation shader, using texel fetches instead.");
+			gl.DeleteProgram(_mipmap_linear_program);
+			_mipmap_linear_program = 0;
+		}
+		else
+		{
+			reshade::log::message(reshade::log::level::info, "Using bilinear mipmap generation shader for filterable formats.");
+		}
+
+		// Linear filtering within the selected level, clamped at the edges (the corner coordinates never reach outside anyway)
+		gl.GenSamplers(1, &_mipmap_linear_sampler);
+		gl.SamplerParameteri(_mipmap_linear_sampler, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_NEAREST);
+		gl.SamplerParameteri(_mipmap_linear_sampler, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		gl.SamplerParameteri(_mipmap_linear_sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		gl.SamplerParameteri(_mipmap_linear_sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	}
 }
