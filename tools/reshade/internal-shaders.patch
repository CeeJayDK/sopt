diff --git a/res/shaders/mipmap_linear_cs_430.glsl b/res/shaders/mipmap_linear_cs_430.glsl
new file mode 100644
index 0000000..de20037
--- /dev/null
+++ b/res/shaders/mipmap_linear_cs_430.glsl
@@ -0,0 +1,17 @@
+#version 430
+
+// Mipmap generation for filterable formats: one bilinear fetch at the shared corner of the 2x2 source texels averages them
+// (the filter weights are exactly 0.5 there), instead of four texel fetches.
+layout(binding = 0) uniform sampler2D src;
+layout(binding = 1) uniform writeonly image2D dest;
+
+layout(location = 0) uniform int src_level;
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+void main()
+{
+	vec2 src_size = vec2(textureSize(src, src_level));
+	vec2 uv = vec2(gl_GlobalInvocationID.xy * 2u + 1u) / src_size;
+	imageStore(dest, ivec2(gl_GlobalInvocationID.xy), textureLod(src, uv, float(src_level)));
+}
