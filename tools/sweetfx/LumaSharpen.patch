+#if __RENDERER__ >= 0xa000 // Direct3D 10+, OpenGL, Vulkan: from the tables (only the chosen pattern's fetches)
+	const int p = pattern * 4;
+
+	float3 blur_ori = tex2D(ReShade::BackBuffer, tex + BUFFER_PIXEL_SIZE * (Offset[p    ] * offset_bias + Shift[p    ])).rgb;
