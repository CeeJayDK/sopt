+	blur_ori +=       tex2D(ReShade::BackBuffer, tex + BUFFER_PIXEL_SIZE * (Offset[p + 2] * offset_bias + Shift[p + 2])).rgb;
+	blur_ori +=       tex2D(ReShade::BackBuffer, tex + BUFFER_PIXEL_SIZE * (Offset[p + 3] * offset_bias + Shift[p + 3])).rgb;
+
+	blur_ori *= 0.25;  // ( /= 4) Divide by the number of texture fetches
+
+	sharp_strength_luma *= PatternStrength[pattern]; // Adjust strength to aproximate the strength of pattern 2
+
+#else // Direct3D 9: ps_3_0 cannot index the tables in a pixel shader (fxc turns every lookup into selects)
 	float3 blur_ori;
 
