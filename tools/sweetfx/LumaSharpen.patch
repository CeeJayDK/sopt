 //#define CoefLuma float3(1.0/3.0, 1.0/3.0, 1.0/3.0) // Equal weight coefficient
 
    /*-----------------------------------------------------------.
+  /                       Sampling patterns                     /
+  '-----------------------------------------------------------*/
+
+// Each pattern takes 4 texture fetches (each one bilinear, so it samples 4 pixels) around the original
+// pixel: fetch k of pattern p is at tex + BUFFER_PIXEL_SIZE * (Offset[4p + k] * offset_bias + Shift[4p + k]).
+// Indexing the tables by the pattern keeps the compiler from running every pattern's fetches when the
+// pattern is a uniform (performance mode off).
+//
+//   [ NW,   , NE ]
+//   [   ,ori,    ]
+//   [ SW,   , SE ]
+//
+// Pattern 1 (Fast) - A 7 tap gaussian using only 2+1 texture fetches (its 2 fetches twice: the second
+// pair hits the texture cache).
+//   [ 1/9, 2/9,    ]     [ 1 , 2 ,   ]
+//   [ 2/9, 8/9, 2/9]  =  [ 2 , 8 , 2 ]
+//   [    , 2/9, 1/9]     [   , 2 , 1 ]
+// Pattern 2 (Normal) - A 9 tap gaussian using 4+1 texture fetches.
+//   [ .25, .50, .25]     [ 1 , 2 , 1 ]
+//   [ .50,   1, .50]  =  [ 2 , 4 , 2 ]
+//   [ .25, .50, .25]     [ 1 , 2 , 1 ]
+// Pattern 3 (Wider) - An experimental 17 tap gaussian using 4+1 texture fetches.
+//   [   , 4 , 6 ,   ,   ]
+//   [   ,16 ,24 ,16 , 4 ]
+//   [ 6 ,24 ,   ,24 , 6 ]
+//   [ 4 ,16 ,24 ,16 ,   ]
+//   [   ,   , 6 , 4 ,   ]
+// Pattern 4 (Pyramid shaped) - A 9 tap high pass (pyramid filter) using 4+1 texture fetches.
+//   [ .50, .50, .50]     [ 1 , 1 , 1 ]
+//   [ .50,    , .50]  =  [ 1 ,   , 1 ]
+//   [ .50, .50, .50]     [ 1 , 1 , 1 ]
+static const float2 Offset[16] =
+{
+	float2( 1.0/3.0,  1.0/3.0), float2(-1.0/3.0, -1.0/3.0), float2( 1.0/3.0,  1.0/3.0), float2(-1.0/3.0, -1.0/3.0), // Fast: NW, SE (twice)
+	float2( 0.5, -0.5), float2(-0.5, -0.5), float2( 0.5,  0.5), float2(-0.5,  0.5), // Normal: SE, SW, NE, NW
+	float2( 0.4, -1.2), float2(-1.2, -0.4), float2( 1.2,  0.4), float2(-0.4,  1.2), // Wider: SSE, WSW, ENE, NNW
+	float2( 0.0, -1.0), float2(-1.0,  0.0), float2( 1.0,  0.0), float2( 0.0,  1.0)  // Pyramid: SSE, WSW, ENE, NNW
+};
+static const float2 Shift[16] =
+{
+	float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0),
+	float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0),
+	float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0), float2(0.0, 0.0),
+	float2(0.5, 0.0), float2(0.0, -0.5), float2(0.0, 0.5), float2(-0.5, 0.0) // Pyramid: half a pixel across, not scaled by offset_bias
+};
+// Strength per pattern, to approximate the strength of pattern 2 (Normal).
+static const float PatternStrength[4] = { 1.5, 1.0, 0.51, 0.666 };
+
